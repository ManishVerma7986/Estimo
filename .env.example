# Copy this file to .env and fill in only credentials your project actually uses.
# Never commit .env. Keep .env.example empty of real credentials.

# Google AI / Gemini (use one variable name)
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# AWS credentials (optional; prefer IAM roles or AWS profiles where available)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
